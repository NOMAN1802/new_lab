{
  "name": "newlab-diagnostic-server",
  "version": "1.0.0",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only ./src/server.ts",
    "lint": "npx eslint .",
    "lint:fix": "npx eslint . --fix",
    "build": "tsc",
    "test": "npm run verify",
    "verify": "npm run build && node scripts/verify-money.js && node scripts/verify-e2e.js",
    "verify:money": "npm run build && node scripts/verify-money.js",
    "verify:e2e": "npm run build && node scripts/verify-e2e.js",
    "verify:cloudinary": "npm run build && node scripts/verify-cloudinary.js"
  },
  "author": "",
  "license": "ISC",
  "description": "New Lab Diagnostic & Consultation Centre — billing & management API",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "http-status": "^2.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.3",
    "multer": "^2.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/eslint__js": "^8.42.3",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.1",
    "eslint": "^9.16.0",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.7",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.17.0"
  }
}
